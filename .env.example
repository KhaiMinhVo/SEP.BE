DB_NAME=influencermatch_dev
DB_USER=influencermatch_user
DB_PASS=12345
DB_PORT=5432
# Generate a different secret for any shared or deployed environment.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=900000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# Development-only ADMIN bootstrap. Use a new email, not the disabled V1 demo account.
BOOTSTRAP_ADMIN_ENABLED=false
PAYMENT_MOCK_ENABLED=false
CREATOR_MOCK_LOGIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=poc-admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-dev-password
BOOTSTRAP_ADMIN_FULL_NAME=PoC Administrator

# Service-only creator ingestion; empty disables ingestion (503).
CREATOR_INGESTION_API_KEY=

# Python AI Service URL for BKAI Vector Embeddings
AI_SERVICE_URL=http://localhost:8000/api/v1/ai/embed
CRAWLER_SERVICE_URL=http://localhost:8000/api/v1/crawl

# Google Gemini API (Campaign AI Autofill)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Registration email delivery (required to register/resend; never commit credentials)
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
EMAIL_OTP_SECRET=
CREATOR_INVITATION_FRONTEND_BASE_URL=http://localhost:5173
# Simulated social proof, dev profile only; never real ownership verification
SOCIAL_PROOF_MOCK_ENABLED=false

# Claim invitations only: durable encrypted outbox, async SMTP and restart-safe retry.
# Required: Base64 of 32 cryptographically random bytes. Keep stable while jobs exist.
EMAIL_OUTBOX_ENCRYPTION_KEY=
CLAIM_EMAIL_DISPATCH_ENABLED=true

# Real Facebook Login for Business: Page and linked Instagram Professional verification.
META_OAUTH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=
META_REDIRECT_URI=http://localhost:8080/api/v1/integrations/meta/callback
# Separate Base64 32-byte AES key; never reuse the outbox/OTP key.
META_OAUTH_ENCRYPTION_KEY=

# Direct Instagram Professional login (no Facebook/Page required), separate app credentials/key.
INSTAGRAM_OAUTH_ENABLED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_OAUTH_ENCRYPTION_KEY=

# TikTok Sandbox OAuth: crawler author ID resolves channel ownership; provider tokens are not persisted.
TIKTOK_SANDBOX_LOGIN_ENABLED=false
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
TIKTOK_SANDBOX_REDIRECT_URI=https://api.influencermatch.site/api/v1/integrations/tiktok/callback
TIKTOK_SANDBOX_SCOPE=user.info.basic,user.info.profile

# Brand-only Google Identity Services (separate from YouTube/channel OAuth)
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=

# Authentication v2: Secure must be true in production; false only for local HTTP
AUTH_COOKIE_SECURE=true
TERMS_VERSION=terms-v1
PRIVACY_VERSION=privacy-v1

# Durable M4 embedding worker; enable only with the AI service configured
BRAND_EMBEDDING_ENABLED=false
BRAND_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
BRAND_EMBEDDING_MODEL_VERSION=m4-embed-v1

# Durable Campaign M3 worker (deployment revision, not provider checkpoint)
CAMPAIGN_EMBEDDING_ENABLED=false
CAMPAIGN_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
CAMPAIGN_EMBEDDING_MODEL_VERSION=m3-embed-v1
