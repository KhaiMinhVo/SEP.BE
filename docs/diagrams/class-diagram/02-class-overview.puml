@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam classBackgroundColor white
skinparam classBorderColor #444444
skinparam classHeaderBackgroundColor #F2F2F2
skinparam packageBackgroundColor white
skinparam packageBorderColor #666666
skinparam ArrowColor #555555
skinparam nodesep 40
skinparam ranksep 65
hide circle
title InfluencerMatch Backend | Core Class Diagram
class User <<entity>> {
- id: UUID
- email: String
- fullName: String
- role: Role
- status: UserStatus
}

class BrandProfile <<entity>> {
- id: UUID
- businessName: String
- industry: String
}

class BrandContext <<entity>> {
- id: UUID
- contextVersion: int
- profileContext: JsonNode
- learnedPatterns: JsonNode
}

class Campaign <<entity>> {
- id: UUID
- name: String
- objective: CampaignObjective
- status: CampaignStatus
- budgetMin: BigDecimal
- budgetMax: BigDecimal
}

class CampaignContext <<entity>> {
- id: UUID
- contextVersion: int
- contextData: JsonNode
- active: boolean
}

class CreatorMaster <<entity>> {
- id: UUID
- canonicalName: String
- status: String
}

class Creator <<entity>> {
- id: UUID
- platform: String
- externalId: String
- displayName: String
- sourceType: CreatorSourceType
}

class PublicCreatorMetric <<entity>> {
- id: UUID
- followers: Long
- engagementRate: BigDecimal
- freshnessStatus: MetricDataStatus
- dataConfidence: BigDecimal
}

class Post <<entity>> {
- id: UUID
- platformPostId: String
- postUrl: String
- views: Long
}

class ShortlistItem <<entity>> {
- id: UUID
- priority: ShortlistPriority
- note: String
}

class BrandCreatorRelationship <<entity>> {
- id: UUID
- stage: RelationshipStage
- quotedFee: BigDecimal
- agreedFee: BigDecimal
}

class Collaboration <<entity>> {
- id: UUID
- agreedFee: BigDecimal
- status: CollaborationStatus
- paymentStatus: CollaborationPaymentStatus
}

class CampaignOutcome <<entity>> {
- id: UUID
- kpiType: String
- kpiTarget: BigDecimal
- kpiActual: BigDecimal
- actualFee: BigDecimal
}

class CreatorReview <<entity>> {
- id: UUID
- overallRating: short
- brandFitRating: short
- wouldCollaborateAgain: Boolean
}

class EvidenceAsset <<entity>> {
- id: UUID
- assetType: String
- storageUrl: String
}

class Plan <<entity>> {
- id: UUID
- planName: String
- price: BigDecimal
- campaignQuota: int
}

class Subscription <<entity>> {
- id: UUID
- status: SubscriptionStatus
- expirationDate: LocalDate
}

class Payment <<entity>> {
- id: UUID
- amount: BigDecimal
- status: PaymentStatus
- transactionCode: String
}

BrandProfile "0..1" --> "1" User : user
BrandContext "0..1" --> "1" BrandProfile : brandProfile
Campaign "0..*" --> "1" BrandProfile : brandProfile
CampaignContext "0..*" --> "1" Campaign : campaign
CreatorMaster "0..1" --> "1" User : user
Creator "0..*" --> "0..1" CreatorMaster : master
PublicCreatorMetric "0..*" --> "1" Creator : creator
Post "0..*" --> "1" Creator : creator
ShortlistItem "0..*" --> "1" Campaign : campaign
ShortlistItem "0..*" --> "1" Creator : creator
BrandCreatorRelationship "0..*" --> "1" Creator : creator
BrandCreatorRelationship "0..*" --> "1" Campaign : campaign
BrandCreatorRelationship "0..*" --> "0..1" ShortlistItem : shortlistItem
Collaboration "0..1" --> "1" BrandCreatorRelationship : relationship
Collaboration "0..*" --> "1" Campaign : campaign
Collaboration "0..*" --> "1" Creator : creator
CampaignOutcome "0..1" --> "1" Collaboration : collaboration
CreatorReview "0..1" --> "1" CampaignOutcome : outcome
EvidenceAsset "0..*" --> "1" CampaignOutcome : outcome
Subscription "0..*" --> "1" BrandProfile : brandProfile
Subscription "0..*" --> "1" Plan : plan
Payment "0..*" --> "1" Subscription : subscription

@enduml
