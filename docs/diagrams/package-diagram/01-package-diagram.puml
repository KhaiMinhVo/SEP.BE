@startuml 01-package-diagram
' Report 4 section 1.2. Source baseline: SEP.BE 5856899.
' Frames are responsibility groups. Rectangles with tabs are Java packages.
' Each visible dependency follows a Java import from the consumer to the supplier.
' Selected dependencies are shown to keep the overview readable.

title InfluencerMatch Backend | Package Diagram
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle folder
skinparam packageBorderColor #435872
skinparam packageBackgroundColor #F0F5FD
skinparam ArrowColor #465F7B
skinparam nodesep 24
skinparam ranksep 55

package "com.influencermatch.backend" #FFFFFF {
  frame "Campaign operations" as CampaignOps {
    package "brand\nBrand profile and M4 context" as Brand
    package "campaign\nBrief, M3 context and history" as Campaign
    package "discovery\nCreator search" as Discovery
    package "recommendation\nRanking and run snapshots" as Recommendation
    package "relationship\nShortlist, comparison and CRM" as Relationship
  }

  frame "Creator identity and collaboration" as CooperationOps {
    package "creator\nCatalogue, OAuth and claims" as Creator {
      package "portal\nCreator-facing API" as Portal
    }
    package "cooperation\nDeals, invitations and execution" as Cooperation
    package "collaboration\nDomain model and repositories" as Collaboration
    package "storage\nImage metadata and storage service" as Storage
    package "taxonomy\nTaxonomy API" as Taxonomy
  }

  frame "Access and operations" as AccessOps {
    package "auth\nLogin, OTP and sessions" as Auth
    package "security\nJWT, guards and RBAC" as Security
    package "user\nUser accounts" as User
    package "admin\nPlatform analytics" as Admin
    package "billing\nPlans and payments" as Billing
    package "audit\nAudit records and export" as Audit
    package "notification\nNotification, SSE and email" as Notification
  }

  frame "Shared backend support" as Shared {
    package "config" as Config
    package "common" as Common
    package "exception" as Exception
  }
}

Brand ..> User
Campaign ..> Brand
Discovery ..> Campaign
Discovery ..> Creator
Recommendation ..> Campaign
Recommendation ..> Relationship
Recommendation ..> Billing
Relationship ..> Creator
Cooperation ..> Relationship
Cooperation ..> Collaboration
Cooperation ..> Portal
Cooperation ..> Audit
Collaboration ..> Notification
Portal ..> Security
Creator ..> Storage
Taxonomy ..> Creator
Auth ..> Security
Security ..> User
Admin ..> Billing
Config ..> Security
Notification ..> Common
Storage ..> Exception

caption Java packages organize campaign operations, creator identity, collaboration and platform services.
@enduml
