@baseUrl = http://localhost:8080/api/v1
@brandEmail = flow1-brand@example.local
@brandPassword = BrandPassword123!
@adminEmail = {{$dotenv BOOTSTRAP_ADMIN_EMAIL}}
@adminPassword = {{$dotenv BOOTSTRAP_ADMIN_PASSWORD}}

### Register BRAND
POST {{baseUrl}}/auth/register
Content-Type: application/json

{"email":"{{brandEmail}}","password":"{{brandPassword}}","fullName":"Flow 1 Brand"}

### Login BRAND
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"{{brandEmail}}","password":"{{brandPassword}}"}
> {%
 client.global.set("brandToken", response.body.data.accessToken);
 client.global.set("brandRefresh", response.body.data.refreshToken);
 client.global.set("brandUserId", response.body.data.user.id);
%}

### Current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{brandToken}}

### Create Brand Profile and M4
POST {{baseUrl}}/brands
Authorization: Bearer {{brandToken}}
Content-Type: application/json

{"businessName":"Flow 1 Labs","industry":"Beauty","productCategories":["Skincare"],"website":"https://example.com","location":"HCMC","targetMarkets":["Vietnam"],"targetAudiences":["Gen Z"],"brandTone":"Friendly","preferredPlatforms":["TIKTOK"],"description":"Flow 1 test brand"}
> {% client.global.set("brandProfileId", response.body.data.id); %}

### Get own Brand Profile
GET {{baseUrl}}/brands/me
Authorization: Bearer {{brandToken}}

### Update Brand Profile and increment M4 version
PUT {{baseUrl}}/brands/{{brandProfileId}}
Authorization: Bearer {{brandToken}}
Content-Type: application/json

{"businessName":"Flow 1 Labs","industry":"Beauty","productCategories":["Skincare"],"website":"https://example.com","location":"HCMC","targetMarkets":["Vietnam"],"targetAudiences":["Gen Z"],"brandTone":"Expert","preferredPlatforms":["TIKTOK"],"description":"Updated profile"}

### Create Campaign Draft
POST {{baseUrl}}/brands/{{brandProfileId}}/campaigns
Authorization: Bearer {{brandToken}}
Content-Type: application/json

{"name":"Flow 1 Campaign","productService":"Daily Serum","objective":"AWARENESS","targetAudiences":["Gen Z"],"contentType":"SHORT_VIDEO","startDate":"2026-10-01","endDate":"2026-10-31","platforms":["TIKTOK"],"niches":["skincare"],"locations":["HCMC"],"followerMin":10000,"followerMax":50000,"budgetMin":3000000,"budgetMax":5000000}
> {% client.global.set("campaignId", response.body.data.id); %}

### List Campaigns
GET {{baseUrl}}/brands/{{brandProfileId}}/campaigns?page=0&size=20
Authorization: Bearer {{brandToken}}

### Expected 409: cannot skip READY_FOR_DISCOVERY
PATCH {{baseUrl}}/campaigns/{{campaignId}}/status
Authorization: Bearer {{brandToken}}
Content-Type: application/json

{"status":"ACTIVE"}

### DRAFT -> READY_FOR_DISCOVERY and create M3
PATCH {{baseUrl}}/campaigns/{{campaignId}}/status
Authorization: Bearer {{brandToken}}
Content-Type: application/json

{"status":"READY_FOR_DISCOVERY"}

### READY_FOR_DISCOVERY -> ACTIVE
PATCH {{baseUrl}}/campaigns/{{campaignId}}/status
Authorization: Bearer {{brandToken}}
Content-Type: application/json

{"status":"ACTIVE"}

### ACTIVE -> COMPLETED
PATCH {{baseUrl}}/campaigns/{{campaignId}}/status
Authorization: Bearer {{brandToken}}
Content-Type: application/json

{"status":"COMPLETED"}

### Login ADMIN
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"{{adminEmail}}","password":"{{adminPassword}}"}
> {% client.global.set("adminToken", response.body.data.accessToken); %}

### Lock BRAND
PATCH {{baseUrl}}/admin/users/{{brandUserId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"status":"LOCKED"}

### Unlock BRAND
PATCH {{baseUrl}}/admin/users/{{brandUserId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"status":"ACTIVE"}
