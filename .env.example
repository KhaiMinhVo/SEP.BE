DB_NAME=influencermatch_dev
DB_USER=influencermatch_user
DB_PASS=12345
DB_PORT=5432
# Generate a different secret for any shared or deployed environment.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=900000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# Development-only ADMIN bootstrap. Use a new email, not the disabled V1 demo account.
BOOTSTRAP_ADMIN_ENABLED=false
PAYMENT_MOCK_ENABLED=false
CREATOR_MOCK_LOGIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=poc-admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-dev-password
BOOTSTRAP_ADMIN_FULL_NAME=PoC Administrator

# Service-only creator ingestion; empty disables ingestion (503).
CREATOR_INGESTION_API_KEY=

# Python AI Service URL for BKAI Vector Embeddings
AI_SERVICE_URL=http://localhost:8000/api/v1/ai/embed
CRAWLER_SERVICE_URL=http://localhost:8000/api/v1/crawl

# Google Gemini API (Campaign AI Autofill)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Registration email delivery (required to register/resend; never commit credentials)
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
EMAIL_OTP_SECRET=
CREATOR_INVITATION_FRONTEND_BASE_URL=http://localhost:5173
# Simulated social proof, dev profile only; never real ownership verification
SOCIAL_PROOF_MOCK_ENABLED=false

# Claim invitations only: durable encrypted outbox, async SMTP and restart-safe retry.
# Required: Base64 of 32 cryptographically random bytes. Keep stable while jobs exist.
EMAIL_OUTBOX_ENCRYPTION_KEY=
CLAIM_EMAIL_DISPATCH_ENABLED=true
