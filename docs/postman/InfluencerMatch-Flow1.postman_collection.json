{
  "info": {"name":"InfluencerMatch Flow 1","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name":"01 Register BRAND","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{brandEmail}}\",\"password\":\"{{brandPassword}}\",\"fullName\":\"Flow 1 Brand\"}"},"url":"{{baseUrl}}/auth/register"}},
    {"name":"02 Login BRAND","event":[{"listen":"test","script":{"exec":["pm.test('login ok', () => pm.response.to.have.status(200));","const d=pm.response.json().data; pm.environment.set('brandToken',d.accessToken); pm.environment.set('brandUserId',d.user.id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{brandEmail}}\",\"password\":\"{{brandPassword}}\"}"},"url":"{{baseUrl}}/auth/login"}},
    {"name":"03 Auth Me","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{brandToken}}"}],"url":"{{baseUrl}}/auth/me"}},
    {"name":"04 Create Brand Profile","event":[{"listen":"test","script":{"exec":["pm.test('created', () => pm.response.to.have.status(201));","pm.environment.set('brandProfileId',pm.response.json().data.id);"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{brandToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"businessName\":\"Flow 1 Labs\",\"industry\":\"Beauty\",\"website\":\"https://example.com\",\"preferredPlatforms\":[\"TIKTOK\"]}"},"url":"{{baseUrl}}/brands"}},
    {"name":"05 Create Campaign","event":[{"listen":"test","script":{"exec":["pm.test('draft created', () => pm.expect(pm.response.json().data.status).to.eql('DRAFT'));","pm.environment.set('campaignId',pm.response.json().data.id);"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{brandToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Flow 1 Campaign\",\"productService\":\"Serum\",\"objective\":\"AWARENESS\",\"platforms\":[\"TIKTOK\"],\"niches\":[\"skincare\"],\"locations\":[\"HCMC\"],\"followerMin\":10000,\"followerMax\":50000,\"budgetMin\":3000000,\"budgetMax\":5000000}"},"url":"{{baseUrl}}/brands/{{brandProfileId}}/campaigns"}},
    {"name":"06 Reject Skipped Transition","event":[{"listen":"test","script":{"exec":["pm.test('conflict', () => pm.response.to.have.status(409));","pm.expect(pm.response.json().code).to.eql('INVALID_CAMPAIGN_TRANSITION');"]}}],"request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{brandToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"ACTIVE\"}"},"url":"{{baseUrl}}/campaigns/{{campaignId}}/status"}},
    {"name":"07 Campaign Ready","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{brandToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"READY_FOR_DISCOVERY\"}"},"url":"{{baseUrl}}/campaigns/{{campaignId}}/status"}},
    {"name":"08 Campaign Active","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{brandToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"ACTIVE\"}"},"url":"{{baseUrl}}/campaigns/{{campaignId}}/status"}},
    {"name":"09 Campaign Completed","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{brandToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"COMPLETED\"}"},"url":"{{baseUrl}}/campaigns/{{campaignId}}/status"}},
    {"name":"10 Login ADMIN","event":[{"listen":"test","script":{"exec":["pm.environment.set('adminToken',pm.response.json().data.accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"},"url":"{{baseUrl}}/auth/login"}},
    {"name":"11 Lock BRAND","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"LOCKED\"}"},"url":"{{baseUrl}}/admin/users/{{brandUserId}}/status"}},
    {"name":"12 Unlock BRAND","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"ACTIVE\"}"},"url":"{{baseUrl}}/admin/users/{{brandUserId}}/status"}}
  ]
}
